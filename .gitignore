# =============================================================================
# ERP AI Agent — Git ignore rules
# =============================================================================

# ---- Secrets (NEVER commit) ----
.env
.env.*
!.env.example

# ---- Local credential drops (NEVER commit) ----
# A token pasted into a file by hand, e.g. `github.txt` (Windows Explorer
# "New text document" produces `github.txt.txt`).  These were previously NOT
# ignored, so a routine `git add .` would have committed a live PAT.
# `*token*.txt` also covers the Vercel_Token.txt described in the runbook.
github.txt
github.txt.txt
*token*.txt
*Token*.txt
*tokens*.txt
*secret*.txt
*secrets*.txt
*credential*.txt
*credentials*.txt

# ---- Vercel ----
.vercel/

# ---- Python virtual environments ----
venv/
env/
.venv/

# ---- Python artifacts ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / Next.js ----
node_modules/
.next/
out/
coverage/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Generated diagnostics & run logs (local debugging leftovers) ----
runapp_log.txt
runapp_test_out.txt
backend.log
frontend.log
dir_grep*.txt
stepmap.txt
syn.txt
sync.txt
pb.txt
pil_ok.txt
r2_*.txt
r3_*.txt
r4_*.txt
reg2_*.txt
reg3_*.txt
reasoning_*.txt
# Session verification outputs (Work Stream K2)
pytest_*.txt
build*.txt
tsc*.txt
vitest*.txt
eval_*.txt
suite_check*.txt
probe.txt
scripts/test_invoice.png

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# ---- Any local log files ----
*.log

# ---- Tests ----
# The backend suite and its golden fixtures ARE tracked.  They are the only
# regression protection this project has, and CI
# (.github/workflows/ci.yml) runs them on every push.  They were previously
# excluded "per project policy", which meant 700+ tests never ran anywhere
# except a developer's machine — and shipped regressions were undetectable.
# Live harnesses remain ignored: they need real credentials and a live
# database, so they are not runnable in CI.
scripts/test_*.py
scripts/smoke_test.py
.env.local
*.png.tmp

