# =============================================================================
# ERP AI Agent — Git ignore rules
# =============================================================================

# ---- Secrets (NEVER commit) ----
.env
.env.*
!.env.example

# ---- Local credential drops (NEVER commit) ----
# A token pasted into a file by hand, e.g. `github.txt` (Windows Explorer
# "New text document" produces `github.txt.txt`).  These were previously NOT
# ignored, so a routine `git add .` would have committed a live PAT.
# `*token*.txt` also covers hand-saved provider tokens.
github.txt
github.txt.txt
*token*.txt
*Token*.txt
*tokens*.txt
*secret*.txt
*secrets*.txt
*credential*.txt
*credentials*.txt

# ---- Vercel ----
.vercel/

# ---- Python virtual environments ----
venv/
env/
.venv/

# ---- Python artifacts ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / Next.js ----
node_modules/
.next/
out/
coverage/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Generated diagnostics & run logs (local debugging leftovers) ----
runapp_log.txt
runapp_test_out.txt
backend.log
frontend.log
dir_grep*.txt
stepmap.txt
syn.txt
sync.txt
pb.txt
pil_ok.txt
r2_*.txt
r3_*.txt
r4_*.txt
reg2_*.txt
reg3_*.txt
reasoning_*.txt
# Local verification output
build*.txt
tsc*.txt
scripts/test_invoice.png

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# ---- Any local log files ----
*.log

# ---- Local scratch ----
scripts/test_*.py
scripts/smoke_test.py
.env.local
*.png.tmp

