# =============================================================================
# ERP AI Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...                     # Public anon key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # Service role key (backend only, NEVER expose to browser)

# ---- Google Gemini ----
# API key is stored in Supabase Vault as GEMINI_API_KEY.
# Retrieved at runtime via public.get_gemini_api_key() (service_role only).
# Do NOT put the key here. Only specify the model:
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# ---- Alibaba Qwen (PRIMARY runtime AI provider) ----
# Alibaba Model Studio workspace key (sk-ws-...). Fill in your real key —
# NEVER hardcode it in source code or commit it to version control.
QWEN_API_KEY=<your-model-studio-workspace-api-key>
# OpenAI-compatible endpoint of your Model Studio workspace:
QWEN_BASE_URL=https://<your-workspace-host>.maas.aliyuncs.com/compatible-mode/v1
QWEN_DASHSCOPE_URL=https://<your-workspace-host>.maas.aliyuncs.com/api/v1
# Exact LLM model code from your workspace (verify live with
# scripts/verify_qwen_models.py; e.g. qwen3.6-plus, qwen-max).
# NOTE: qwen3.7-plus is BANNED from the runtime chain (constitution rule).
QWEN_MODEL=qwen3.6-plus
QWEN_TEMPERATURE=0.1
QWEN_MAX_OUTPUT_TOKENS=2048
QWEN_TIMEOUT_SECONDS=30
# Ordered fallback chains (comma-separated). Banned models are filtered out
# automatically by app.config; verify all IDs live against your workspace.
QWEN_MODEL_CHAIN=qwen3.6-plus,qwen-max
QWEN_VISION_MODEL_CHAIN=qwen3-vl-plus,qwen3-vl-flash
QWEN_BANNED_MODELS=qwen3.7-plus

# ---- AI Provider Orchestration ----
AI_PRIMARY_PROVIDER=qwen
AI_FALLBACK_PROVIDER=gemini
PROVIDER_HEALTH_TTL_SECONDS=60

# ---- Application ----
APP_ENV=development                           # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# ---- Security ----
# CORS origins (comma-separated)
# ---- Security --------------------------------------------------------
# Legacy X-User-Id header auth fallback. Only honoured when APP_ENV is
# exactly "development" AND this flag is true. Leave it unset/false in
# staging and production: a header-only request is then rejected with 401
# instead of being trusted as that user. Defaults to false.
ALLOW_DEV_HEADER_AUTH=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT secret for internal/test HS256 tokens (generate with: openssl rand -hex 32)
# NOTE: Supabase projects with asymmetric JWT signing keys issue ES256 tokens
# that are verified against the project's public JWKS endpoint — JWT_SECRET is
# ONLY used for the legacy HS256 fallback path and local test-token minting.
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# ---- Database ----
# Connection pooling (Supabase uses PgBouncer)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
